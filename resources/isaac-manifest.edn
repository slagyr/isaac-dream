{:id          :isaac.dream
 :version     "0.1.0"
 :builtin?    true
 :factory     isaac.dream.module/create-module
 :description "Dreaming for Isaac — a crew distills conversations into private habits."
 :handbook    "isaac/dream/handbook.md"
 :isaac.agent/tools {:dream/propose {:factory isaac.dream.tools/propose-tool-factory}}
 :isaac.agent/system-sections {:habits {:factory isaac.dream.habits/section :order 900}}
 :isaac/cli {:dream {:usage "dream <subcommand> [options]"
                      :summary "Manage crew habits"
                      :namespace isaac.dream.cli :hosted true}}
 :isaac.config/schema
 {:crew {:schema {:type :map :value-spec {:type :map :schema
                         {:dream {:type :map :factory isaac.dream.run/make-service :schema
                                  {:enabled {:type :boolean}
                                   :schedule {:type :string}
                                   :approval {:type :keyword :validations [[:one-of? :manual :auto]]}
                                   :model {:type :string}
                                   :digest {:type :map :schema {:comm {:type :string} :to {:type :string}}}}}}}}}}
 :isaac.config/check
 {:dream-schedule {:fn isaac.dream.run/check-schedules}}}
